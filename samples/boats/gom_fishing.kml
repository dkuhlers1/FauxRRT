<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Gulf of America fishing fleet</name>
    <description>Sample shrimp and longline reports for debris-risk receptors.</description>
    <Schema id="BoatSchema" name="Boat">
      <SimpleField type="double" name="speed_kn"><displayName>Speed (kn)</displayName></SimpleField>
      <SimpleField type="double" name="heading_deg"><displayName>Heading (deg true)</displayName></SimpleField>
      <SimpleField type="int" name="people_on_board"><displayName>People on board</displayName></SimpleField>
      <SimpleField type="double" name="length_m"><displayName>Boat length (m)</displayName></SimpleField>
      <SimpleField type="double" name="age_s"><displayName>Seconds since last position</displayName></SimpleField>
    </Schema>
    <Placemark>
      <name>FV Gulf Star</name>
      <description>Steel shrimp trawler south of Grand Isle</description>
      <ExtendedData>
        <SchemaData schemaUrl="#BoatSchema">
          <SimpleData name="speed_kn">7.8</SimpleData>
          <SimpleData name="heading_deg">248</SimpleData>
          <SimpleData name="people_on_board">5</SimpleData>
          <SimpleData name="length_m">23</SimpleData>
          <SimpleData name="age_s">42</SimpleData>
        </SchemaData>
      </ExtendedData>
      <Point><coordinates>-90.05,28.85,0</coordinates></Point>
    </Placemark>
